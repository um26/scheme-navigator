{
  "name": "scheme-navigator",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:data": "node scripts/build-schemes.mjs && node scripts/build-map.mjs && node scripts/build-constellation.mjs",
    "prebuild": "npm run i18n:check && npm run build:data",
    "build": "next build",
    "start": "next start",
    "i18n:export-ui": "node scripts/export-ui-source.mjs",
    "i18n:translate": "python scripts/translate-catalog.py",
    "i18n:translate-ui": "python scripts/translate-catalog-fast.py --locales all --tier ui --batch-size 64 --beams 1",
    "i18n:lint": "node scripts/lint-i18n-ui.mjs",
    "i18n:status": "node scripts/i18n-status.mjs",
    "i18n:check": "npm run i18n:lint && node scripts/check-i18n-coverage.mjs",
    "release:prepare": "npm run i18n:lint && npm run i18n:export-ui && npm run i18n:translate-ui && npm run i18n:check",
    "release:check": "npm run build"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "d3-geo": "^3.1.1",
    "hyparquet": "^1.28.2",
    "ml-pca": "^4.1.1",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.1",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
